{
    "model_config": "guangyangmusic/legato-small",
    "pretrained_model": "guangyangmusic/legato-small",

    "load_in_4bit": true,
    "bnb_4bit_compute_dtype": "float16",

    "peft_strategy": "lora",
    "vision_rank": 4,
    "decoder_rank": 8,
    "peft_alpha": 16,
    "peft_dropout": 0.05,

    "dataset_path": "datasets/PDMX-SmashcimaHW",
    "mini_val_file": "datasets/mini_val_hw.json",
    "mini_test_file": "datasets/mini_test_hw.json",
    "dummy_data": false,

    "output_dir": "outputs/legato-dlora-t4/",
    "remove_unused_columns": false,

    "run_name": "legato-dlora-t4",
    "do_train": true,
    "do_eval": true,
    "do_predict": false,
    "dataloader_num_workers": 2,
    "dataloader_prefetch_factor": 2,
    "ddp_find_unused_parameters": false,
    "fp16": true,
    "num_train_epochs": 1,
    "max_steps": 500,
    "learning_rate": 1e-4,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 16,
    "gradient_checkpointing": true,
    "warmup_ratio": 0.05,
    "logging_steps": 25,
    "save_strategy": "steps",
    "save_steps": 50,
    "save_total_limit": 2,
    "per_device_eval_batch_size": 1,
    "eval_strategy": "steps",
    "eval_steps": 50,
    "metric_for_best_model": "eval_SER",
    "greater_is_better": false,
    "load_best_model_at_end": true,
    "fp16_full_eval": true,
    "predict_with_generate": true,
    "generation_max_length": 768,
    "generation_num_beams": 1,
    "torch_compile": false,
    "report_to": "none",
    "restore_callback_states_from_checkpoint": true,
    "log_level": "info"
}
